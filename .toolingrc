# Per-repo configuration for the shared FuguBSD tooling. The synced
# scripts read their identity keys here. See FuguBSD/Tooling.
sync.pack org
sync.pack perl
sync.pack web
dist.name     App-FuguWeb
dist.module   App::FuguWeb
dist.abstract build a documentation website for a Perl project
dist.author   Dick Olsson <hi@senzilla.io>
dist.exe      bin/fuguweb
dist.testdir  t/fuguweb
